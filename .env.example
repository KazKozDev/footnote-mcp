# footnote-mcp environment template.
# Copy this file to `.env` for local use, or paste selected variables into your
# MCP client config under the server's `env` field.
#
# All keys below are optional. The server starts without API keys and falls back
# to zero-key Bing, DuckDuckGo, Brave, and Wiby discovery, browser
# fallback, and offline verification.

# Required only by the hosted Streamable HTTP server (`footnote_mcp.http_server`).
# Set PUBLIC_URL to the public origin, without `/mcp`, and give clients the same
# API key as an Authorization: Bearer token.
FOOTNOTE_MCP_API_KEY=
FOOTNOTE_MCP_PUBLIC_URL=
# Optional per-user credentials. JSON object: user ID -> key and requests/minute.
# Example: {"alice":{"key":"fn_replace_me","rpm":20}}
FOOTNOTE_MCP_API_KEYS={}
# Applied to the owner key and user records without an explicit `rpm`.
FOOTNOTE_MCP_DEFAULT_RPM=30

# Optional zero-key SearXNG provider. Point this at a self-hosted instance or a
# public instance that has JSON output enabled. `auto` tries it first.
FOOTNOTE_SEARXNG_URL=

# Optional keyed search providers.
# These are metered, so they are a fallback rather than the default: the zero-key tier
# answers first, and one keyed provider is called only when it returns fewer than
# FOOTNOTE_MIN_FREE_RESULTS strong matches. Configured providers take turns so a single
# quota is not drained first. Google needs BOTH variables; either alone is ignored.
FOOTNOTE_MIN_FREE_RESULTS=3
# Set to `merge` to call every configured provider on every query, as older versions did.
FOOTNOTE_PROVIDER_STRATEGY=cost_aware
TAVILY_API_KEY=
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
FOOTNOTE_BRAVE_COOLDOWN_SECONDS=300
FOOTNOTE_DDG_COOLDOWN_SECONDS=120
FOOTNOTE_RESEARCH_MODEL=

# Optional polite-pool identifier for Crossref; no API key or registration is
# required. Example: research@example.com
CROSSREF_MAILTO=

# Optional GitHub token raises API rate limits. Public repository/issue search
# works without it, subject to GitHub's unauthenticated per-IP limit.
GITHUB_TOKEN=

# Optional semantic reranking via local Ollama embeddings.
# Used when a tool request enables semantic search/reranking.
FOOTNOTE_EMBED_MODEL=bge-m3

# Optional local NLI model for `evidence_entailment` with backend="local_nli".
# Requires installing the extra dependencies from `requirements-nli.txt`.
FOOTNOTE_NLI_MODEL=

# Browser fallback for JavaScript-heavy or blocked pages.
# Enabled by default; set to 0 to disable the Chromium fallback tier.
FOOTNOTE_BROWSER_FALLBACK=1

# Optional proxy support for fetch/browser escalation.
# Use comma-separated proxy URLs; leave empty for direct connections.
FOOTNOTE_PROXIES=

# Optional hosted scrape API fallback.
# Set FOOTNOTE_SCRAPE_API to `firecrawl` or `scrapingbee`, then provide the
# matching provider key below.
FOOTNOTE_SCRAPE_API=
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=

# Fetch politeness and anti-blocking controls.
# Defaults are conservative enough for normal use; tune only when needed.
FOOTNOTE_DOMAIN_RPS=3
FOOTNOTE_DOMAIN_BURST=5
FOOTNOTE_BREAKER_THRESHOLD=5
FOOTNOTE_BREAKER_COOLDOWN=120
FOOTNOTE_NEGCACHE_TTL=300
FOOTNOTE_THIN_CONTENT_CHARS=200

# Persistent source cache.
# Default: ~/.footnote-mcp/source_cache/
FOOTNOTE_SOURCE_CACHE=

# Search-result cache for the scraped engines (Bing, DuckDuckGo, Brave).
# A repeated query is answered from disk instead of spending another request
# against the provider's rate limit. Set the TTL to 0 to disable.
# Default: ~/.footnote-mcp/search_cache/, 86400 seconds.
FOOTNOTE_SEARCH_CACHE=
FOOTNOTE_SEARCH_CACHE_TTL=86400
